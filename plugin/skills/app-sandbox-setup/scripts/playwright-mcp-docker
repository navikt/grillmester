#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "playwright-mcp-docker: $1" >&2
  exit 1
}

PW_VERSION="${PW_VERSION:-1.63.0}"
MCP_VERSION="${MCP_VERSION:-0.0.80}"
IMAGE="${PW_IMAGE:-mcr.microsoft.com/playwright:v${PW_VERSION}-noble}"
CONFIG="${PW_MCP_CONFIG:-$HOME/.config/playwright-mcp/docker.json}"
NAME="copilot-playwright-${PW_VERSION}"
TIMEOUT="${PW_READY_TIMEOUT:-60}"
[[ "$PW_VERSION" =~ ^[0-9A-Za-z._-]+$ ]] || fail "Invalid PW_VERSION."
[[ "$MCP_VERSION" =~ ^[0-9A-Za-z._-]+$ ]] || fail "Invalid MCP_VERSION."
[[ "$IMAGE" =~ ^[a-z0-9][a-z0-9./:@_-]+$ ]] || fail "Invalid PW_IMAGE (expected an image reference, optionally digest-pinned)."
[[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || fail "PW_READY_TIMEOUT must be a positive number of seconds."

command -v python3 >/dev/null 2>&1 || fail "python3 is required to read docker.json safely."
python3 -c pass >/dev/null 2>&1 || fail "python3 could not run; the macOS Command Line Tools stub may need installation. Use an installed Python 3.9+."
parameters="$(python3 -c '
import json, os, re, sys
from urllib.parse import urlsplit
try:
    with open(sys.argv[1]) as stream:
        remote = json.load(stream)["browser"]["remoteEndpoint"]
    endpoint = remote["endpoint"]
    url = urlsplit(endpoint)
    port = os.environ.get("PW_DOCKER_PORT") or str(url.port)
    path = os.environ.get("PW_SERVER_PATH") or url.path
    if not path.startswith("/"):
        path = "/" + path
    valid = (url.scheme == "ws" and url.hostname == "127.0.0.1"
             and url.username is None and url.password is None and not url.query and not url.fragment
             and re.fullmatch(r"[0-9]{1,5}", port) and 1 <= int(port) <= 65535
             and re.fullmatch(r"/[A-Za-z0-9_-]{32,}", path)
             and int(port) == url.port and path == url.path)
    if not valid:
        raise ValueError("Invalid endpoint.")
    print(port)
    print(path)
except (OSError, ValueError, KeyError, TypeError, AttributeError):
    sys.exit(1)
' "$CONFIG" 2>/dev/null)" || fail "Invalid docker.json endpoint or conflicting port/path override; rerun the setup helper."
PORT="${parameters%%$'\n'*}"
SERVER_PATH="${parameters#*$'\n'}"

DOCKER="$(command -v docker || true)"
if [ -z "$DOCKER" ]; then
  for directory in "$HOME/.rd/bin" "$HOME/.orbstack/bin" /opt/homebrew/bin /usr/local/bin /Applications/Docker.app/Contents/Resources/bin; do
    if [ -x "$directory/docker" ]; then
      DOCKER="$directory/docker"
      break
    fi
  done
fi
[ -n "$DOCKER" ] || fail "Docker unavailable; install/start it outside the sandbox."
if ! "$DOCKER" image inspect "$IMAGE" >/dev/null 2>&1; then
  # Never pull automatically: credential helpers cannot run in the app sandbox.
  fail "Image missing or Docker inaccessible. Run outside the sandbox: docker pull $IMAGE"
fi

inspect_container() {
  local container inspection
  container="$("$DOCKER" inspect --type container "$NAME" 2>/dev/null || true)"
  inspection="$(printf '%s' "$container" | python3 -c '
import json, re, sys
raw = sys.stdin.read()
try:
    containers = json.loads(raw) if raw.strip() else []
    if containers == []:
        print("no\n-")
        sys.exit(0)
    container = containers[0]
    identifier = container["Id"]
    if not isinstance(identifier, str) or not re.fullmatch(r"[a-f0-9]{64}", identifier):
        sys.exit(1)
except (ValueError, KeyError, IndexError, TypeError):
    sys.exit(1)
try:
    config = container["Config"]
    cmd = config["Cmd"]
    host = container["HostConfig"]
    bindings = host["PortBindings"]["3333/tcp"]
    matches = (container["State"]["Running"]
               and cmd[cmd.index("--path") + 1] == sys.argv[1]
               and bindings == [{"HostIp": "127.0.0.1", "HostPort": sys.argv[2]}]
               and config["User"] == "pwuser" and config["WorkingDir"] == "/home/pwuser"
               and config["Image"] == sys.argv[3] and "--unsafe" not in cmd
               and host["CapDrop"] == ["ALL"] and not host.get("CapAdd")
               and host["Privileged"] is False
               and any(option in ("no-new-privileges", "no-new-privileges=true")
                       for option in host["SecurityOpt"])
               and host["ShmSize"] == 1073741824 and host["IpcMode"] == "private"
               and host["Init"] is True and host["AutoRemove"] is True)
except (ValueError, KeyError, IndexError, TypeError):
    matches = False
print("yes" if matches else "no")
print(identifier)
' "$SERVER_PATH" "$PORT" "$IMAGE" 2>/dev/null)" || fail "Could not validate the existing container."
  matches="${inspection%%$'\n'*}"
  CONTAINER_ID="${inspection#*$'\n'}"
}

inspect_container
if [ "$matches" != yes ]; then
  # Use the inspected immutable ID, never the name a concurrent starter may claim.
  if [ "$CONTAINER_ID" != "-" ]; then
    "$DOCKER" rm -f "$CONTAINER_ID" >/dev/null 2>&1 || true
  fi
  if ! "$DOCKER" run -d --pull=never --rm --init --name "$NAME" \
    --cap-drop=ALL --security-opt no-new-privileges --shm-size=1g \
    --user pwuser --workdir /home/pwuser -p "127.0.0.1:${PORT}:3333" \
    "$IMAGE" npx -y "playwright@${PW_VERSION}" run-server \
    --port 3333 --host 0.0.0.0 --path "$SERVER_PATH" >/dev/null 2>&1; then
    # A concurrent wrapper may have won the name. Reuse it only after full validation.
    inspect_container
    [ "$matches" = yes ] || fail "Container startup failed; check Docker outside the sandbox."
  fi
fi

command -v curl >/dev/null 2>&1 || fail "curl is required for the readiness check."
deadline=$((SECONDS + TIMEOUT))
while ! curl --noproxy '*' --silent --output /dev/null --max-time 1 "http://127.0.0.1:${PORT}/" 2>/dev/null; do
  [ "$SECONDS" -lt "$deadline" ] || fail "Readiness timed out; check Docker and the loopback/masking policy."
  sleep 1
done

for runner in pnpm npx; do
  executable="$(command -v "$runner" || true)"
  if [ -z "$executable" ] && [ -x "$HOME/.local/share/mise/shims/$runner" ]; then
    executable="$HOME/.local/share/mise/shims/$runner"
  fi
  if [ -n "$executable" ]; then
    if [ "$runner" = pnpm ]; then
      exec "$executable" dlx "@playwright/mcp@${MCP_VERSION}" --config "$CONFIG" "$@"
    else
      exec "$executable" -y "@playwright/mcp@${MCP_VERSION}" --config "$CONFIG" "$@"
    fi
  fi
done
fail "Install pnpm or npx (also checked mise shims)."
