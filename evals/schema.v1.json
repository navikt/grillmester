{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/navikt/grillmester/blob/main/evals/schema.v1.json",
  "title": "Grillmester evaluation corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "suiteId",
    "title",
    "policies",
    "responseSignals",
    "statusContracts",
    "confusablePairs",
    "cases"
  ],
  "properties": {
    "$schema": { "const": "./schema.v1.json" },
    "schemaVersion": { "const": 1 },
    "suiteId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "policies": { "$ref": "#/$defs/policies" },
    "responseSignals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/responseSignal" }
    },
    "statusContracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/statusContract" }
    },
    "confusablePairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/confusablePair" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evalCase" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thresholds", "aiCreditCaps"],
      "properties": {
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic", "safety", "behavioral"],
          "properties": {
            "deterministic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimumPassRate"],
              "properties": {
                "minimumPassRate": { "const": 1.0 }
              }
            },
            "safety": { "$ref": "#/$defs/repetitionThreshold" },
            "behavioral": { "$ref": "#/$defs/repetitionThreshold" }
          }
        },
        "aiCreditCaps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxPerRun", "maxPerCase", "maxPerSuite"],
          "properties": {
            "maxPerRun": { "type": "integer", "minimum": 1 },
            "maxPerCase": { "type": "integer", "minimum": 1 },
            "maxPerSuite": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "repetitionThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "minimumPasses"],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1 },
        "minimumPasses": { "type": "integer", "minimum": 1 }
      }
    },
    "responseSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "oracle"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "oracle": { "$ref": "#/$defs/responseSignalOracle" }
      }
    },
    "responseSignalOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicate", "description"],
      "properties": {
        "kind": {
          "enum": [
            "trace-predicate",
            "response-predicate",
            "trace-response-predicate"
          ]
        },
        "predicate": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "statusContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agent", "statuses"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "agent": { "$ref": "#/$defs/id" },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z_]*$"
          }
        }
      }
    },
    "confusablePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skillIds", "caseIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "skillIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "caseIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "evalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "evaluationClass",
        "runner",
        "title",
        "prompt",
        "unsafe",
        "execution",
        "assertions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "entry-agent-selection",
            "skill-routing",
            "delegation-topology",
            "role-boundary",
            "non-interactive-degradation",
            "prompt-injection-safety"
          ]
        },
        "evaluationClass": { "enum": ["safety", "behavioral"] },
        "runner": { "enum": ["manual", "future-sdk"] },
        "subjectAgent": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "unsafe": { "type": "boolean" },
        "execution": { "$ref": "#/$defs/execution" },
        "assertions": { "$ref": "#/$defs/assertions" },
        "topology": { "$ref": "#/$defs/topology" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "runner": { "const": "future-sdk" } },
            "required": ["runner"]
          },
          "then": { "required": ["subjectAgent"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "delegation-topology" } },
            "required": ["kind"]
          },
          "then": { "required": ["topology"] }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "maxAiCreditsPerRun", "maxAiCreditsTotal"],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1 },
        "maxAiCreditsPerRun": { "type": "integer", "minimum": 0 },
        "maxAiCreditsTotal": { "type": "integer", "minimum": 0 }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "tools", "sideEffects"],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "negative": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "tools": { "$ref": "#/$defs/toolPolicy" },
        "sideEffects": { "$ref": "#/$defs/sideEffectPolicy" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "agent-selected",
            "agent-invoked",
            "skill-invoked",
            "status-returned",
            "response-signal"
          ]
        },
        "target": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "forbidden"],
      "properties": {
        "required": { "$ref": "#/$defs/uniqueIdArray" },
        "forbidden": { "$ref": "#/$defs/uniqueIdArray" }
      }
    },
    "sideEffectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxLocalWrites", "maxGitWrites", "maxExternalWrites"],
      "properties": {
        "maxLocalWrites": { "type": "integer", "minimum": 0 },
        "maxGitWrites": { "type": "integer", "minimum": 0 },
        "maxExternalWrites": { "type": "integer", "minimum": 0 }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryAgent", "edges", "maxConcurrentWriters", "statusContracts"],
      "properties": {
        "entryAgent": { "$ref": "#/$defs/id" },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/topologyEdge" }
        },
        "maxConcurrentWriters": { "type": "integer", "minimum": 0 },
        "statusContracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "topologyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "order", "purpose"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "purpose": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
