{
  "schemaVersion": 1,
  "target": "opencode-v1",
  "output": "targets/opencode-v1",
  "source": {
    "pluginManifest": "plugin/plugin.json",
    "agents": "plugin/agents",
    "skills": "plugin/skills"
  },
  "agents": {
    "designer": {
      "mode": "primary",
      "hidden": false,
      "skillAccess": "allow-with-manual-ask",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask"
        },
        "webfetch": "ask",
        "websearch": "ask",
        "todowrite": "ask",
        "question": "allow",
        "task": {
          "*": "deny",
          "perspektiv": "allow",
          "researcher": "allow"
        }
      }
    },
    "doctor-who": {
      "mode": "primary",
      "hidden": false,
      "skillAccess": "allow-with-manual-ask",
      "permission": {
        "edit": "ask",
        "webfetch": "ask",
        "websearch": "ask",
        "todowrite": "ask",
        "question": "allow",
        "bash": "deny",
        "task": "deny"
      }
    },
    "grill-inspektor": {
      "mode": "subagent",
      "hidden": true,
      "skillAccess": "allow-with-manual-ask",
      "permission": {
        "doom_loop": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": "ask",
        "edit": "deny",
        "question": "deny",
        "task": "deny"
      }
    },
    "grillmester": {
      "mode": "primary",
      "hidden": false,
      "skillAccess": "allow-with-manual-ask",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask",
        "websearch": "ask",
        "todowrite": "ask",
        "question": "allow",
        "task": {
          "*": "deny",
          "grill-inspektor": "allow",
          "researcher": "allow"
        }
      }
    },
    "perspektiv": {
      "mode": "subagent",
      "hidden": true,
      "skillAccess": "allow-with-manual-ask",
      "permission": {
        "doom_loop": "deny",
        "todowrite": "deny",
        "edit": "deny",
        "bash": "deny",
        "question": "deny",
        "task": "deny"
      }
    },
    "researcher": {
      "mode": "subagent",
      "hidden": true,
      "skillAccess": "deny",
      "permission": {
        "doom_loop": "deny",
        "todowrite": "deny",
        "edit": "deny",
        "bash": "deny",
        "question": "deny",
        "task": "deny"
      }
    }
  },
  "runtimeTextReplacements": [
    {
      "from": "agent task tool",
      "to": "`subagent` tool"
    },
    {
      "from": "`ask_user`",
      "to": "`question`"
    },
    {
      "from": "`execute`",
      "to": "`shell`"
    },
    {
      "from": "built-in search tool",
      "to": "built-in `grep`/`glob` tools"
    },
    {
      "from": "rerouting to Copilot CLI/app or a repository-approved\nMCP",
      "to": "rerouting to an OpenCode session with approved external retrieval"
    },
    {
      "from": "GitHub Copilot's supported fields",
      "to": "the target runtime's supported fields"
    }
  ],
  "pathTextReplacements": {
    "agents/doctor-who.md": [
      {
        "from": "shell, `shell` or delegation tools",
        "to": "`shell` or delegation tools"
      }
    ],
    "skills/create-a-skill/references/principles.md": [
      {
        "from": "Use GitHub Copilot's supported invocation fields rather than encoding policy\nin prose.",
        "to": "Keep portable skill metadata in `SKILL.md`, OpenCode slash entry points in\n`commands/`, and model access in ordered `permission.skill` rules rather than\nencoding invocation policy in prose."
      }
    ],
    "skills/create-a-skill/references/glossary.md": [
      {
        "from": "Runtime\nbehavior is configured through the target runtime's supported fields, which define\nexactly how model and user reach are configured.",
        "to": "Runtime behavior is split between portable skill metadata, explicit OpenCode\ncommand wrappers, and ordered `permission.skill` rules."
      }
    ]
  },
  "overlays": {
    "skills/doctor/SKILL.md": "policy/opencode-v1/overlays/skills/doctor/SKILL.md",
    "skills/create-a-skill/SKILL.md": "policy/opencode-v1/overlays/skills/create-a-skill/SKILL.md",
    "skills/create-a-skill/references/opencode-validation.md": "policy/opencode-v1/overlays/skills/create-a-skill/references/opencode-validation.md"
  },
  "remove": [
    "skills/create-a-skill/references/copilot-cli-validation.md"
  ],
  "skillCapabilities": {
    "default": "native",
    "overrides": {
      "create-a-skill": "overlay",
      "doctor": "overlay"
    }
  },
  "forbiddenRuntimeTokens": [
    "ask_user",
    "`execute`",
    "`web`",
    "agent task tool",
    "`agent` tool",
    "built-in search tool"
  ],
  "forbiddenByPrefix": {
    "skills/doctor/": [
      "Copilot",
      ".github/copilot"
    ],
    "skills/create-a-skill/": [
      "Copilot",
      "copilot"
    ],
    "skills/handoff/": [
      "GitHub Copilot"
    ]
  }
}
