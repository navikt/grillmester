{
  "schemaVersion": 1,
  "projection": "focused-context-v1",
  "sources": {
    "plugin": "plugin",
    "opencode": "targets/opencode-v1"
  },
  "outputs": {
    "opencode": "targets/opencode-v1-focused",
    "copilotCli": "targets/copilot-cli-focused-v1"
  },
  "agents": [
    "barista",
    "grill-inspektor"
  ],
  "skills": [
    "diagnosing-bugs",
    "integration-tests",
    "issue-management",
    "pull-request",
    "review",
    "security-review",
    "tdd"
  ],
  "fullContextHandoff": {
    "status": "NEEDS_FULL_CONTEXT",
